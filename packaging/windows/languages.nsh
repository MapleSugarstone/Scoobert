; The installer's own text in each language Scoobert offers. makensis reads this file as UTF-8 because
; scripts/package-windows.ps1 passes /INPUTCHARSET UTF8. Button names in the text match the NSIS language files.

!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "Spanish"
!insertmacro MUI_LANGUAGE "French"
!insertmacro MUI_LANGUAGE "German"
!insertmacro MUI_LANGUAGE "PortugueseBR"
!insertmacro MUI_LANGUAGE "Italian"
!insertmacro MUI_LANGUAGE "Russian"
!insertmacro MUI_LANGUAGE "Japanese"
!insertmacro MUI_LANGUAGE "Korean"
!insertmacro MUI_LANGUAGE "SimpChinese"
!insertmacro MUI_LANGUAGE "Arabic"
!insertmacro MUI_LANGUAGE "Kurdish"
!insertmacro MUI_LANGUAGE "Armenian"
!insertmacro MUI_LANGUAGE "Irish"
; NSIS ships no Sorani or Tagalog, so their language files are in the lang folder next to this one.
!insertmacro MUI_LANGUAGEEX "${__FILEDIR__}\lang" "Sorani"
!insertmacro MUI_LANGUAGEEX "${__FILEDIR__}\lang" "Tagalog"

; The code Scoobert reads from language.txt.
